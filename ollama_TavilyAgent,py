
import os
import requests
from typing import Dict, Any

TAVILY_BASE_URL = "https://api.tavily.com"

class TavilyError(Exception):
    pass

from google.colab import userdata


def tavily_search(
    query: str,
    *,
    days: int ,           # 直近N日でフィルタ
) -> Dict[str, Any]:
    """
    Tavily Search API を呼び出すユーティリティ関数。
    返り値は Tavily の検索レスポンス(JSON)をそのまま返す。
    """
    api_key = userdata.get('TAVILY_API_KEY')
    if not api_key:
        raise TavilyError("環境変数 TAVILY_API_KEY を設定してください。")

    url = f"{TAVILY_BASE_URL}/search"
    headers = {"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"}

    payload: Dict[str, Any] = {
        "query": query,
        "max_results": 5,
        "include_answer": True,
        "search_depth": "basic",
        "auto_parameters": True,
    }
    if days is not None:
        payload["days"] = days

    resp = requests.post(url, headers=headers, json=payload, timeout=30)
    if resp.status_code != 200:
        try:
            detail = resp.json()
        except Exception:
            detail = resp.text
        raise TavilyError(f"HTTP {resp.status_code}: {detail}")

    return resp.json()


